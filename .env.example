# Contact form (src/app/api/contact/route.ts), server only: never prefix with NEXT_PUBLIC_
RESEND_API_KEY=
# With the default sender, Resend only delivers to the email the Resend account is registered with
CONTACT_TO_EMAIL=
# Optional, needs a domain verified in Resend
# CONTACT_FROM=Portfolio <hello@your-domain.com>

# Public site URL: canonical links, sitemap, Open Graph
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app
